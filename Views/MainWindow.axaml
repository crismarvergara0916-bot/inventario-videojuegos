<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InventarioVideojuegos.Views.MainWindow"
        Title="Inventario de Videojuegos"
        Width="1000" Height="620" MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="Auto,*,Auto" Margin="16">

    <TextBlock Grid.Row="0" Text="Inventario de Videojuegos"
               FontSize="24" FontWeight="Bold" Margin="0,0,0,12" />

    <Grid Grid.Row="1" ColumnDefinitions="300,16,*">

      <!-- Formulario -->
      <Border Grid.Column="0" BorderThickness="1" BorderBrush="Gray"
              CornerRadius="6" Padding="12">
        <ScrollViewer>
          <StackPanel Spacing="6">
            <TextBlock Text="Datos del videojuego" FontWeight="SemiBold" />

            <TextBlock Text="Título" />
            <TextBox x:Name="TxtTitulo" MaxLength="100" Watermark="Ej: The Legend of Zelda" />

            <TextBlock Text="Plataforma" />
            <TextBox x:Name="TxtPlataforma" Watermark="Ej: Switch, PS5, PC" />

            <TextBlock Text="Género" />
            <TextBox x:Name="TxtGenero" Watermark="Ej: Aventura" />

            <TextBlock Text="Año de lanzamiento" />
            <TextBox x:Name="TxtAnio" Watermark="Ej: 2023" />

            <TextBlock Text="Precio" />
            <TextBox x:Name="TxtPrecio" Watermark="Ej: 59.99" />

            <TextBlock Text="Estado" />
            <ComboBox x:Name="CmbEstado" HorizontalAlignment="Stretch" />

            <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,8,Auto" Margin="0,10,0,0">
              <Button x:Name="BtnAgregar" Grid.Row="0" Grid.Column="0"
                      Content="Agregar" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center" Click="BtnAgregar_Click" />
              <Button x:Name="BtnActualizar" Grid.Row="0" Grid.Column="2"
                      Content="Actualizar" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center" Click="BtnActualizar_Click" />
              <Button x:Name="BtnEliminar" Grid.Row="2" Grid.Column="0"
                      Content="Eliminar" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center" Click="BtnEliminar_Click" />
              <Button x:Name="BtnLimpiar" Grid.Row="2" Grid.Column="2"
                      Content="Limpiar" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center" Click="BtnLimpiar_Click" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Listado -->
      <Grid Grid.Column="2" RowDefinitions="Auto,8,*">
        <TextBox x:Name="TxtBuscar" Grid.Row="0"
                 Watermark="Buscar por título..." TextChanged="TxtBuscar_TextChanged" />

        <DataGrid x:Name="GridVideojuegos" Grid.Row="2"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" GridLinesVisibility="Horizontal"
                  SelectionChanged="GridVideojuegos_SelectionChanged">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="50" />
            <DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="*" />
            <DataGridTextColumn Header="Plataforma" Binding="{Binding Plataforma}" Width="100" />
            <DataGridTextColumn Header="Género" Binding="{Binding Genero}" Width="100" />
            <DataGridTextColumn Header="Año" Binding="{Binding Anio}" Width="60" />
            <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat={}{0:N2}}" Width="80" />
            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="100" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Grid>

    <!-- Barra de mensajes -->
    <Border Grid.Row="2" Margin="0,12,0,0" Padding="8" CornerRadius="4"
            BorderThickness="1" BorderBrush="Gray">
      <TextBlock x:Name="TxtMensaje" Text="Listo." TextWrapping="Wrap" />
    </Border>

  </Grid>
</Window>
